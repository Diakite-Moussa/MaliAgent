# =========================================================
# MaliAgent — Exemple de Configuration (.env.example)
# =========================================================

# Environnement (dev / prod)
ENV=dev

# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg://maliagent:maliagent@127.0.0.1:5434/maliagent

# LLM Provider (Ollama Cloud / Anthropic / OpenAI)
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
META_APP_SECRET=your_meta_app_secret

# Authentification JWT
JWT_SECRET_KEY=change_moi_avec_une_valeur_aleatoire_longue_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Sécurité des Sessions & Cookies
# Si non défini, secure=True est automatique en production (ENV=prod)
# COOKIE_SECURE=false

# Rate Limiting sur /api/auth/login
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# URLs et CORS
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# =========================================================
# Paiements Mobile Money (Wave, Orange Money, Moov Money)
# =========================================================
# Mode de paiement : 'simulation' (recommandé en dev) ou 'production'
PAYMENT_MODE=simulation
# Passerelle par défaut : 'mock', 'wave', 'orange_money', 'moov'
PAYMENT_PROVIDER=mock
# Délai de grâce pour réutiliser une session de paiement pending (minutes)
PAYMENT_SESSION_EXPIRY_MINUTES=15

# Wave Mali (Production)
WAVE_API_KEY=
WAVE_API_URL=https://api.wave.com/v1/checkout/sessions
WAVE_WEBHOOK_SECRET=

# Orange Money Mali (Production)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_API_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_WEBHOOK_SECRET=

# Moov Money Mali (Production)
MOOV_CLIENT_ID=
MOOV_CLIENT_SECRET=
MOOV_API_URL=https://api.moov-africa.ml/flooz/v1
MOOV_WEBHOOK_SECRET=

# =========================================================
# Vocal & Multilingue (STT Whisper & TTS Edge/MMS)
# =========================================================
# STT Provider : 'mock' ou 'whisper_cloud'
STT_PROVIDER=mock
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# TTS Provider : 'mock' ou 'edge'
TTS_PROVIDER=mock
AUDIO_STORAGE_DIR=storage/audio