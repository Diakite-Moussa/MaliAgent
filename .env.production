# =========================================================
# MaliAgent — Environnement de Production (.env.production)
# =========================================================

ENV=prod

# Base de données PostgreSQL en conteneur Docker / Cloud managé
DATABASE_URL=postgresql+psycopg://maliagent_prod_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/maliagent_prod

# Clé secrète JWT (générer une clé de 64 hexadecimals : openssl rand -hex 32)
JWT_SECRET_KEY=GENERATE_PROD_SECRET_HEX_64_CHARACTERS_MINIMUM
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Provider (Ollama Cloud / Anthropic / OpenAI selon déploiement)
OLLAMA_API_KEY=YOUR_PRODUCTION_OLLAMA_API_KEY
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

# Meta WhatsApp Cloud API (identifiants de l'App Meta en production)
WHATSAPP_ACCESS_TOKEN=YOUR_PRODUCTION_META_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PRODUCTION_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_SECRET_WEBHOOK_VERIFY_TOKEN
META_APP_SECRET=YOUR_PRODUCTION_META_APP_SECRET

# URL Publique du service (utilisée pour les liens de factures PDF et webhook)
PUBLIC_BASE_URL=https://api.maliagent.ml

# CORS : Origines autorisées en production (Dashboard commerçant)
CORS_ORIGINS=https://app.maliagent.ml,https://dashboard.maliagent.ml
